# Ключи расшифровки. Если система сценариев (урок 1) стоит в ~/scenarios, ключи берутся оттуда сами –
# здесь можно ничего не писать. Файл .env никому не пересылай.

# Groq – бесплатно, console.groq.com → API Keys
GROQ_API_KEY=

# ElevenLabs – точнее всего пишет запинки и повторы, платно по минутам. elevenlabs.io → Developers → API Keys,
# включить Speech to Text
ELEVENLABS_API_KEY=

# Нет ни одного ключа – расшифровка пойдёт whisper'ом на компьютере (медленнее, первый раз скачает ~1,6 ГБ)
# LOCAL_WHISPER_MODEL=large-v3-turbo

# Язык речи в роликах
# MONTAGE_LANG=ru
